{
  "name": "interactive-ai-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "preview": "pnpm --filter site preview",
    "capture:safety-evidence": "node scripts/capture-safety-evidence.mjs",
    "capture:llm-system-evidence": "node scripts/capture-llm-system-evidence.mjs",
    "capture:v1.4-evidence": "node scripts/capture-v1.4-evidence.mjs",
    "capture:v1.5-evidence": "node scripts/capture-v1.5-evidence.mjs",
    "capture:v1.6-evidence": "node scripts/capture-v1.6-evidence.mjs",
    "capture:v1.7-evidence": "node scripts/capture-v1.7-evidence.mjs",
    "capture:p2-evidence": "node scripts/capture-p2-evidence.mjs",
    "analyze:learning-metrics": "node scripts/analyze-learning-metrics.ts",
    "smoke:production:privacy": "node scripts/smoke-production-privacy.mjs",
    "render:diagrams": "node scripts/render-diagram-assets.mjs",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint && pnpm check:metrics-analysis",
    "check:metrics-analysis": "tsc -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "pnpm --filter @ai-history/data validate"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.0.1",
    "prettier": "3.9.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@11.7.0"
}
