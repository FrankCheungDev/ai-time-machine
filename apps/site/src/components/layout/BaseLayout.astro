---
import "../../styles/tokens.css";
import {
  defaultLocale,
  getPathLocale,
  toLocalizedPath,
  type Locale,
} from "../../i18n/locales";
import { getSiteCopy } from "../../i18n/siteCopy";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  noindex?: boolean;
  alternatePath?: string | false;
  languageSwitchPath?: string;
}

const pathname = Astro.url.pathname;
const locale = Astro.props.locale ?? getPathLocale(pathname);
const copy = getSiteCopy(locale);
const {
  title,
  description = copy.defaultDescription,
  noindex = false,
  alternatePath = pathname,
  languageSwitchPath = pathname,
} = Astro.props;
const fullTitle = `${title} | ${copy.siteTitle}`;
const siteBase = Astro.site ?? Astro.url.origin;
const canonicalPath = toLocalizedPath(pathname, locale);
const canonicalUrl = new URL(canonicalPath, siteBase);
const socialImageUrl = new URL("/social-card.png", siteBase);
const chineseUrl =
  alternatePath === false
    ? undefined
    : new URL(toLocalizedPath(alternatePath, defaultLocale), siteBase);
const englishUrl =
  alternatePath === false
    ? undefined
    : new URL(toLocalizedPath(alternatePath, "en"), siteBase);
const ogLocale = locale === "en" ? "en_US" : "zh_CN";
const alternateOgLocale = locale === "en" ? "zh_CN" : "en_US";

const switchLocale: Locale = locale === "en" ? defaultLocale : "en";
const languageSwitchHref = toLocalizedPath(languageSwitchPath, switchLocale);
const isCurrentPage = (href: string) =>
  pathname === toLocalizedPath(href, locale);
const isChapterSection =
  pathname.startsWith(toLocalizedPath("/chapters/", locale)) ||
  pathname === toLocalizedPath("/chapters/overview/", locale);

const localizeHref = (href: string) => toLocalizedPath(href, locale);
const chapterNavigationHref = `${localizeHref("/")}#learning-path`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {chineseUrl && <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />}
    {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {
      chineseUrl && (
        <link rel="alternate" hreflang="x-default" href={chineseUrl} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={copy.socialImageAlt} />
    <title>{fullTitle}</title>
    <script is:inline>
      window.__aiHistoryHydrationErrors = new WeakSet();
      window.__aiHistoryInteractionEpoch = 0;
      window.addEventListener(
        "astro:hydration-error",
        (event) => {
          if (event.target instanceof HTMLElement) {
            window.__aiHistoryHydrationErrors.add(event.target);
          }
        },
        { capture: true },
      );
      const markUserInteraction = (event) => {
        if (
          !event.isTrusted ||
          (event instanceof KeyboardEvent && event.repeat)
        )
          return;
        window.__aiHistoryInteractionEpoch += 1;
      };
      window.addEventListener("keydown", markUserInteraction, {
        capture: true,
      });
      window.addEventListener("pointerdown", markUserInteraction, {
        capture: true,
      });
      window.addEventListener("wheel", markUserInteraction, {
        capture: true,
      });
      window.addEventListener("click", markUserInteraction, {
        capture: true,
      });
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizeHref("/")}>
        <span class="brand-mark" aria-hidden="true">AI</span>
        <span>{copy.siteTitle}</span>
      </a>
      <nav aria-label={copy.navLabel}>
        <a
          href={localizeHref("/")}
          aria-current={isCurrentPage("/") ? "page" : undefined}
        >
          {copy.nav.home}
        </a>
        <a
          href={localizeHref("/timeline/")}
          aria-current={isCurrentPage("/timeline/") ? "page" : undefined}
        >
          {copy.nav.timeline}
        </a>
        <a
          href={localizeHref("/lineage/")}
          aria-current={isCurrentPage("/lineage/") ? "page" : undefined}
        >
          {copy.nav.lineage}
        </a>
        <a
          href={chapterNavigationHref}
          class:list={[{ "is-active-section": isChapterSection }]}
          aria-current={isChapterSection ? "page" : undefined}
        >
          {copy.nav.chapters}
        </a>
        <a
          href={localizeHref("/diagrams/")}
          aria-current={isCurrentPage("/diagrams/") ? "page" : undefined}
        >
          {copy.nav.diagrams}
        </a>
        <a
          href={localizeHref("/privacy/")}
          aria-current={isCurrentPage("/privacy/") ? "page" : undefined}
        >
          {copy.nav.privacy}
        </a>
      </nav>
      <a
        class="language-switch"
        href={languageSwitchHref}
        aria-label={copy.language.switchAriaLabel}
        data-language-switch
        data-language-target={switchLocale}
      >
        {copy.language.switchLabel}
      </a>
    </header>
    <slot />
    <script>
      import { initializeLanguagePreference } from "../../i18n/languagePreference";

      initializeLanguagePreference();
    </script>
  </body>
</html>

<style>
  .language-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-line, #d7ddd7);
    border-radius: 8px;
    color: var(--color-ink, #17201d);
    background: var(--color-surface, #fff);
    font-weight: 720;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .site-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 12px;
      row-gap: 8px;
    }

    .brand {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .language-switch {
      grid-column: 2;
      grid-row: 1;
    }

    .site-header nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
