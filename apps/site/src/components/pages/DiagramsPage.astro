---
import { getDiagramAssets } from "@ai-history/data";
import BaseLayout from "../layout/BaseLayout.astro";
import {
  coreDiagrams,
  diagramNamingCards,
  diagramsPageCopy,
  diagramWorkflowSteps,
} from "../../i18n/pages";
import { type Locale, toLocalizedPath } from "../../i18n/locales";
import { getLocalizedLearningChapter } from "../../i18n/learning";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = diagramsPageCopy[locale];
const workflowSteps = diagramWorkflowSteps[locale];
const namingCards = diagramNamingCards[locale];
const diagrams = coreDiagrams[locale];
const assets = getDiagramAssets(locale);
const href = (path: string) => toLocalizedPath(path, locale);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <main class="chapter-main">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 class="page-title">{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>

    <section class="section-band" aria-labelledby="export-flow">
      <p class="eyebrow">{copy.workflowEyebrow}</p>
      <h2 id="export-flow">{copy.workflowHeading}</h2>
      <div class="pill-grid">
        {workflowSteps.map((step) => <div class="pill">{step}</div>)}
      </div>
    </section>

    <section class="section-band" aria-labelledby="naming">
      <p class="eyebrow">{copy.namingEyebrow}</p>
      <h2 id="naming">{copy.namingHeading}</h2>
      <div class="demo-grid">
        {
          namingCards.map((card) => (
            <div class="demo-card">
              <strong>{card.title}</strong>
              <p>{card.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section-band" aria-labelledby="downloads">
      <p class="eyebrow">{copy.downloadsEyebrow}</p>
      <h2 id="downloads">{copy.downloadsHeading}</h2>
      <div class="diagram-asset-grid">
        {
          assets.map((asset) => {
            const chapter = getLocalizedLearningChapter(
              asset.chapterId,
              locale,
            );

            return (
              <article class="demo-card diagram-asset-card" data-diagram-asset>
                <img
                  src={asset.pngPath}
                  alt={asset.title}
                  width="1200"
                  height="646"
                  loading="lazy"
                />
                <span>{chapter.label}</span>
                <strong>{asset.title}</strong>
                <p>{asset.stateLabel}</p>
                <dl>
                  <div>
                    <dt>{copy.assetStateLabel}</dt>
                    <dd>
                      <code>{asset.stateId}</code>
                    </dd>
                  </div>
                  <div>
                    <dt>{copy.assetVersionLabel}</dt>
                    <dd>
                      {asset.version} · {asset.updatedAt}
                    </dd>
                  </div>
                  <div>
                    <dt>{copy.assetLicenseLabel}</dt>
                    <dd>{asset.license}</dd>
                  </div>
                </dl>
                <p class="asset-ids">
                  <b>{copy.stableIdsLabel}</b>
                  <code>{asset.stableIds.nodes[0]}</code>,{" "}
                  <code>{asset.stableIds.arrows[0]}</code>
                </p>
                <p class="asset-note">
                  <b>{copy.simplificationLabel}</b>
                  {asset.simplificationNote}
                </p>
                <div class="asset-actions">
                  <a
                    class="button"
                    href={asset.svgPath}
                    download
                    aria-label={`${copy.downloadSvgLabel}: ${asset.title}`}
                  >
                    {copy.downloadSvgLabel}
                  </a>
                  <a
                    class="button secondary"
                    href={asset.pngPath}
                    download
                    aria-label={`${copy.downloadPngLabel}: ${asset.title}`}
                  >
                    {copy.downloadPngLabel}
                  </a>
                  <a href={chapter.href}>{copy.openChapterLabel}</a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="section-band" aria-labelledby="core-diagrams">
      <p class="eyebrow">{copy.coreEyebrow}</p>
      <h2 id="core-diagrams">{copy.coreHeading}</h2>
      <div class="demo-grid overview-grid">
        {
          diagrams.map((diagram) => (
            <a class="demo-card" href={href(diagram.route)} data-core-diagram>
              <span>{copy.diagramLabel}</span>
              <strong>{diagram.title}</strong>
              <p>{diagram.note}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section-band" aria-labelledby="screenshots">
      <p class="eyebrow">{copy.screenshotsEyebrow}</p>
      <h2 id="screenshots">{copy.screenshotsHeading}</h2>
      <p>{copy.screenshotsBody}</p>
    </section>
  </main>
</BaseLayout>

<style>
  .diagram-asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }

  .diagram-asset-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .diagram-asset-card img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: #fbfbf8;
  }

  .diagram-asset-card dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
  }

  .diagram-asset-card dl div {
    padding: 10px;
    border-radius: 8px;
    background: #f7faf8;
  }

  .diagram-asset-card dt {
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 720;
  }

  .diagram-asset-card dd {
    margin: 3px 0 0;
    overflow-wrap: anywhere;
  }

  .asset-ids,
  .asset-note {
    margin: 0;
    font-size: 0.9rem;
  }

  .asset-ids b,
  .asset-note b {
    display: block;
    margin-bottom: 4px;
    color: var(--color-ink);
  }

  .asset-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 6px;
  }

  .asset-actions .secondary {
    color: var(--color-green);
    background: white;
  }

  @media (max-width: 520px) {
    .diagram-asset-card dl {
      grid-template-columns: 1fr;
    }

    .asset-actions .button {
      flex: 1;
      text-align: center;
    }
  }
</style>
