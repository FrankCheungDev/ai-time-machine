---
import BaseLayout from "../layout/BaseLayout.astro";
import { llmSystemChapterCopy } from "../../i18n/pages";
import type { Locale } from "../../i18n/locales";
import { getLocalizedLearningChapter } from "../../i18n/learning";
import LlmSystemDemo from "../../demos/llm-system/LlmSystemDemo.svelte";
import ChapterJourney from "../learning/ChapterJourney.svelte";
import ChapterProgress from "../learning/ChapterProgress.astro";
import ConceptCheck from "../learning/ConceptCheck.svelte";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = llmSystemChapterCopy[locale];
const chapter = getLocalizedLearningChapter("llm-system", locale);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <main class="chapter-main">
    <ChapterProgress {locale} chapterId="llm-system" />
    <p class="eyebrow">{chapter.label}</p>
    <h1 class="page-title">{copy.title}</h1>
    <p class="lede">{copy.lede}</p>
    <p class="chapter-question">{copy.question}</p>

    <LlmSystemDemo client:load {locale} />

    <section class="section-band" aria-labelledby="chapter-notes">
      <p class="eyebrow">{copy.notesEyebrow}</p>
      <h2 id="chapter-notes">{copy.notesTitle}</h2>
      <div class="demo-grid overview-grid">
        {
          copy.cards.map((card) => (
            <div class="demo-card">
              <span>{card.label}</span>
              <strong>{card.title}</strong>
              <p>{card.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section-band" aria-labelledby="llm-simplification">
      <p class="eyebrow">{copy.simplificationEyebrow}</p>
      <h2 id="llm-simplification">{copy.simplificationTitle}</h2>
      <p>{copy.simplificationBody}</p>
      <p class="eyebrow">{copy.referencesEyebrow}</p>
      <ul>
        {
          copy.references.map((reference) => (
            <li>
              <a href={reference.href}>{reference.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
    <ConceptCheck client:load {locale} chapterId="llm-system" />
    <ChapterJourney client:load {locale} chapterId="llm-system" />
  </main>
</BaseLayout>
